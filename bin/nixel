#!/usr/bin/env bash
# SPDX-License-Identifier: MIT
#
# The nixel command line: Emacs in batch mode running nixel-cli-main.
# NIXEL_EMACS names the Emacs to run; the default is the first on PATH.
here="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
exec "${NIXEL_EMACS:-emacs}" --batch -Q --eval '(setq load-prefer-newer t)' \
  -L "$here/lisp" -l nixel-cli -f nixel-cli-main "$@"
