#!/usr/bin/env bash
# SPDX-License-Identifier: MIT
#
# The nix-conformance adapter for elnix (github:numtide/nix-conformance).
# Exit 3 tells the runner that elnix does not implement an operation.
here="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
op=$1 file=$2
shift 2
case $op in
  eval) exec "$here/bin/elnix" eval --strict "$@" "$file" ;;
  eval-xml) exec "$here/bin/elnix" eval --strict --xml --no-location "$@" "$file" ;;
  check) exec "$here/bin/elnix" check "$file" ;;
  *) exit 3 ;;
esac
